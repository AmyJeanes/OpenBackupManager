<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet Audit only warns: about vulnerable packages, and with NU1900 when it can't get its data, as offline -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Releases set the version from their tag -->
    <Version>0.0.0</Version>
    <Company>Amy Jeanes</Company>
    <Product>Open Backup Manager</Product>
    <RepositoryUrl>https://github.com/AmyJeanes/OpenBackupManager</RepositoryUrl>
    <!-- As site_url in docs/zensical.toml, which a test checks -->
    <GuideUrl>https://amyjeanes.github.io/OpenBackupManager/</GuideUrl>
    <CopyrightYears>2026</CopyrightYears>
    <CopyrightYears Condition="$([System.DateTime]::UtcNow.Year) &gt; 2026">2026&#x2013;$([System.DateTime]::UtcNow.Year)</CopyrightYears>
    <Copyright>© $(CopyrightYears) $(Company)</Copyright>
  </PropertyGroup>

  <!-- The SDK does this for RepositoryUrl itself -->
  <ItemGroup>
    <AssemblyMetadata Include="GuideUrl" Value="$(GuideUrl)" />
  </ItemGroup>
</Project>

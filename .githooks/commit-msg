#!/bin/sh
# Turns AI tools' Co-authored-by trailers into Assisted-by, since some tools add them whatever their instructions say.

awk '
{
    line = $0
    lower = tolower(line)
    if (lower ~ /^co-authored-by:/) {
        name = line
        sub(/^[^:]*: */, "", name)
        sub(/ *<[^>]*> *$/, "", name)
        if (lower ~ /@anthropic\.com>/)
            line = (name ~ /^Claude( Code)?$/) ? "Assisted-by: Claude Code" : "Assisted-by: Claude Code (" name ")"
        else if (lower ~ /@cursor\.com>/)
            line = "Assisted-by: Cursor"
        else if (lower ~ /@openai\.com>/)
            line = "Assisted-by: Codex"
        else if (tolower(name) == "copilot")
            line = "Assisted-by: GitHub Copilot"
    }
    if (line ~ /^Assisted-by: / && seen[line]++)
        next
    print line
}' "$1" > "$1.tmp" && mv "$1.tmp" "$1"

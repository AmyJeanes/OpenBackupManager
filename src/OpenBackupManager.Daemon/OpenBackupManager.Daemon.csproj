<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Platform.Windows can only be referenced from a Windows-only framework, so obmd uses one when built there -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>obmd</AssemblyName>
    <RootNamespace>OpenBackupManager.Daemon</RootNamespace>
    <PublishAot>true</PublishAot>
    <!-- The Windows app builds it for its own runtime, to go beside it -->
    <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBackupManager.Engine\OpenBackupManager.Engine.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\OpenBackupManager.Platform.Windows\OpenBackupManager.Platform.Windows.csproj" />
  </ItemGroup>

</Project>

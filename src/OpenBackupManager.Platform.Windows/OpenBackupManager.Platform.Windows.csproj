<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- CsWin32's generated Windows API code uses pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CsWin32 writes its code before compiling, so .NET's COM source generators convert every call, as NativeAOT needs -->
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <!-- Only 64-bit Windows is shipped, where structs are laid out as on x64 -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Windows.CsWin32" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBackupManager.Core\OpenBackupManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenBackupManager.Platform.Windows.Tests" />
  </ItemGroup>

</Project>

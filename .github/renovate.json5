{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    ":automergeMinor"
  ],
  "automergeType": "branch",
  "pinDigest": {
    "automerge": true
  },
  "packageRules": [
    {
      "groupName": "NUnit",
      "matchPackageNames": ["NUnit", "NUnit.*", "NUnit3TestAdapter"]
    }
  ]
}

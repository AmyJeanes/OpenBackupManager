{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    ":automergeMinor"
  ],
  "automergeType": "branch",
  "pinDigest": {
    "automerge": true
  },
  // Updates the docs site's lock file by running pip-compile again, so the hashes stay right
  "pip-compile": {
    "managerFilePatterns": ["/^docs/requirements\\.txt$/"],
    // Weekly, since an update to Zensical itself only moves what it pulls in when it has to
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["before 4am on monday"]
    }
  },
  "pip_requirements": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The rclone release bundled with the app",
      "managerFilePatterns": ["/^rclone\\.version$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?<currentValue>v\\S+)"]
    },
    {
      "customType": "regex",
      "description": "Container images CI runs with docker run, pinned by digest",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": ["(?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "groupName": "NUnit",
      "matchPackageNames": ["NUnit", "NUnit.*", "NUnit3TestAdapter"]
    },
    {
      // vpk warns when it packs an app built with a different Velopack version
      "groupName": "Velopack",
      "matchPackageNames": ["Velopack", "vpk"]
    },
    {
      "groupName": "Windows App SDK",
      "matchPackageNames": ["Microsoft.WindowsAppSDK.*"]
    },
    {
      // rclone's behaviour can change between releases in ways CI doesn't catch yet, so its updates wait for review
      "matchDepNames": ["rclone/rclone"],
      "automerge": false
    },
    {
      // FlaUI releases every 2 to 3 years but is still maintained, so a year without one doesn't mean it's abandoned
      "matchPackageNames": ["FlaUI.*"],
      "abandonmentThreshold": "3 years"
    },
    {
      // The oldest distros the Linux downloads are checked on, so only their digests update
      "matchDepNames": ["debian", "registry.access.redhat.com/ubi9/ubi-minimal"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      // Zensical is in alpha, so an update can change how the site looks without failing its build
      "matchPackageNames": ["zensical"],
      "automerge": false
    }
  ]
}
